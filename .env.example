# ------------------------------------------------------------
# FFMPEG / FFPROBE
# ------------------------------------------------------------

NEXORA_FFMPEG_PATH=ffmpeg
NEXORA_FFPROBE_PATH=ffprobe


# ------------------------------------------------------------
# MEDIA SCANNER
# ------------------------------------------------------------

# عدد عمليات الفحص المتزامنة
NEXORA_SCAN_WORKERS=8

# مراقبة المجلدات بشكل Recursive
NEXORA_WATCH_RECURSIVE=true

# فاصل مراقبة الملفات بالثواني
NEXORA_WATCH_INTERVAL_SECONDS=3


# ------------------------------------------------------------
# REDIS
# ------------------------------------------------------------

NEXORA_REDIS_ADDR=127.0.0.1:6379

# اتركه فارغًا إذا لم يتم وضع كلمة مرور
NEXORA_REDIS_PASSWORD=

# Redis Database
NEXORA_REDIS_DB=0


# ------------------------------------------------------------
# ADMIN / AUTHENTICATION
# ------------------------------------------------------------

NEXORA_ADMIN_USER=admin

# غيّرها إلى كلمة مرور قوية
