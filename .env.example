NEXORA_HTTP_ADDR=:8080
# عنوان داخلي لخادم API يستخدمه Vite أثناء التطوير فقط. اتركه محلياً عادة.
NEXORA_API_UPSTREAM=http://127.0.0.1:8080
NEXORA_DATABASE_URL=postgres://nexora:nexora@localhost:15432/nexora?sslmode=disable
NEXORA_MIGRATIONS_DIR=migrations
NEXORA_MEDIA_ROOTS=D:\Media;E:\Media
NEXORA_MEILI_HOST=http://127.0.0.1:7700
NEXORA_MEILI_API_KEY=
NEXORA_MEILI_INDEX=media_items
NEXORA_ASSET_IMAGE_DIR=assets/images
NEXORA_TMDB_API_KEY=
NEXORA_TMDB_BEARER_TOKEN=
NEXORA_MAL_CLIENT_ID=
NEXORA_MAL_ACCESS_TOKEN=
NEXORA_FFMPEG_PATH=ffmpeg
NEXORA_FFPROBE_PATH=ffprobe
NEXORA_SCAN_WORKERS=8
NEXORA_WATCH_RECURSIVE=true
NEXORA_ANDROID_TARGET=Download
NEXORA_IOS_BUNDLE_ID=org.videolan.vlc-ios

NEXORA_REDIS_ADDR=127.0.0.1:6379
NEXORA_REDIS_PASSWORD=
NEXORA_REDIS_DB=0
NEXORA_WATCH_INTERVAL_SECONDS=3

# إعدادات أمان ومصادقة المشرف (Admin Credentials & Auth Secret)
NEXORA_ADMIN_USER=admin
NEXORA_ADMIN_PASS=change_this_password_in_production
NEXORA_ADMIN_SECRET=generate_strong_random_secret_for_token_signing_2026

# إعدادات الواجهة الأمامية (Vite Frontend Configuration)
VITE_API_BASE_URL=http://127.0.0.1:8080

