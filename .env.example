
# ============================================================
# NEXORA - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# HTTP / API SERVER
# ------------------------------------------------------------

NEXORA_HTTP_ADDR=:8080

# عنوان API الداخلي الذي يستخدمه Vite أثناء التطوير
NEXORA_API_UPSTREAM=http://127.0.0.1:8080

# عنوان API للواجهة الأمامية Vite
VITE_API_BASE_URL=http://127.0.0.1:8080


# ------------------------------------------------------------
# DATABASE - PostgreSQL
# ------------------------------------------------------------

NEXORA_DATABASE_URL=postgres://nexora:nexora@localhost:15432/nexora?sslmode=disable

# مجلد ترحيلات قاعدة البيانات
NEXORA_MIGRATIONS_DIR=migrations


# ------------------------------------------------------------
# MEDIA LIBRARY ROOTS
# ------------------------------------------------------------

# يمكن إضافة أكثر من مجلد باستخدام ;
NEXORA_MEDIA_ROOTS=D:\Media;E:\Media;C:\Users\mousa\Desktop\مسلسل اجنبي


# ------------------------------------------------------------
# SEARCH ENGINE - Meilisearch
# ------------------------------------------------------------

NEXORA_MEILI_HOST=http://127.0.0.1:7700

# اتركه فارغًا إذا لم يتم تفعيل مفتاح Meilisearch
NEXORA_MEILI_API_KEY=

# اسم فهرس الوسائط
NEXORA_MEILI_INDEX=media_items


# ------------------------------------------------------------
# MEDIA ASSETS / IMAGES
# ------------------------------------------------------------

NEXORA_ASSET_IMAGE_DIR=assets/images


